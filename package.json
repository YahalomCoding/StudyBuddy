{
  "name": "studybuddy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@studybuddy/api --filter=@studybuddy/client",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "seed:demo": "npm run seed:demo --workspace=@studybuddy/api",
    "postinstall": "node scripts/fix-nest-core.js"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/passport-jwt": "^4.0.1",
    "prettier": "^3.7.4",
    "turbo": "^2.7.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@react-oauth/google": "^0.13.5",
    "bcrypt": "^6.0.0",
    "google-auth-library": "^10.6.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  }
}
