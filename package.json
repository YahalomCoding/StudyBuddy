{
  "name": "studybuddy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@studybuddy/api --filter=@studybuddy/client",
    "dev:local": "npm run db:setup && npm run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:setup": "node scripts/setup-local-db.js",
    "postinstall": "node scripts/fix-nest-core.js"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/passport-jwt": "^4.0.1",
    "esbuild": "^0.28.1",
    "prettier": "^3.7.4",
    "turbo": "^2.7.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@react-oauth/google": "^0.13.5",
    "bcrypt": "^6.0.0",
    "google-auth-library": "^10.6.2",
    "ical.js": "^2.2.1",
    "jwt-decode": "^4.0.0",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.1",
    "@rollup/rollup-darwin-arm64": "^4.62.3",
    "@swc/core-darwin-arm64": "^1.15.47"
  }
}
