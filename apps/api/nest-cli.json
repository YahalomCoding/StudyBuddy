{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "controllerFileNameSuffix": [
            ".swagger-controller.ts"
          ],
          "dtoFileNameSuffix": [
            ".dto.ts",
            ".classes.ts"
          ],
          "classValidatorShim": false
        }
      }
    ]
  }
}